{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["images", "existingSecret", "serviceAccount", "backend", "frontend", "ingress", "networkPolicy", "monitoring", "revisionHistoryLimit"],
  "properties": {
    "images": {"$ref": "#/definitions/images"},
    "existingSecret": {"type": "string", "minLength": 1},
    "serviceAccount": {"type": "object", "additionalProperties": false, "required": ["create", "name", "annotations", "automountServiceAccountToken"], "properties": {"create": {"type": "boolean"}, "name": {"type": "string"}, "annotations": {"$ref": "#/definitions/stringMap"}, "automountServiceAccountToken": {"type": "boolean"}}},
    "backend": {
      "type": "object", "additionalProperties": false,
      "required": ["replicas", "strategy", "config", "migration", "terminationGracePeriodSeconds", "podAnnotations", "podSecurityContext", "securityContext", "probes", "resources", "topologySpreadConstraints", "affinity", "tolerations", "pdb", "autoscaling"],
      "properties": {
        "replicas": {"type": "integer", "minimum": 1},
        "strategy": {"type": "object", "additionalProperties": false, "required": ["type"], "properties": {"type": {"enum": ["Recreate", "RollingUpdate"]}}},
        "config": {"type": "object", "additionalProperties": false, "required": ["appEnv", "appUrl", "frontendOrigin", "corsAllowedOrigins", "cookieDomain", "allowSignup", "disableWorkspaceCreation", "googleClientId", "googleRedirectUri", "s3Bucket", "s3Region", "cloudfrontDomain", "cloudfrontKeyPairId", "localUploadBaseUrl", "redisUrl", "realtimeRelayMode", "databaseMaxConns", "databaseMinConns", "metricsAddr"], "properties": {"appEnv": {"type": "string"}, "appUrl": {"type": "string"}, "frontendOrigin": {"type": "string"}, "corsAllowedOrigins": {"type": "string"}, "cookieDomain": {"type": "string"}, "allowSignup": {"type": "boolean"}, "disableWorkspaceCreation": {"type": "boolean"}, "googleClientId": {"type": "string"}, "googleRedirectUri": {"type": "string"}, "s3Bucket": {"type": "string"}, "s3Region": {"type": "string", "minLength": 1}, "cloudfrontDomain": {"type": "string"}, "cloudfrontKeyPairId": {"type": "string"}, "localUploadBaseUrl": {"type": "string"}, "redisUrl": {"type": "string"}, "realtimeRelayMode": {"enum": ["legacy", "sharded", "dual"]}, "databaseMaxConns": {"type": "integer", "minimum": 1}, "databaseMinConns": {"type": "integer", "minimum": 0}, "metricsAddr": {"type": "string"}}},
        "migration": {"type": "object", "additionalProperties": false, "required": ["enabled", "backoffLimit", "activeDeadlineSeconds", "ttlSecondsAfterFinished"], "properties": {"enabled": {"type": "boolean"}, "backoffLimit": {"type": "integer", "minimum": 0}, "activeDeadlineSeconds": {"type": "integer", "minimum": 60}, "ttlSecondsAfterFinished": {"type": "integer", "minimum": 0}}},
        "terminationGracePeriodSeconds": {"type": "integer", "minimum": 30},
        "podAnnotations": {"$ref": "#/definitions/stringMap"},
        "podSecurityContext": {"type": "object"},
        "securityContext": {"$ref": "#/definitions/securityContext"},
        "probes": {"$ref": "#/definitions/probes"},
        "resources": {"type": "object"},
        "topologySpreadConstraints": {"type": "array"},
        "affinity": {"type": "object"},
        "tolerations": {"type": "array"},
        "pdb": {"$ref": "#/definitions/pdb"},
        "autoscaling": {"$ref": "#/definitions/autoscaling"}
      }
    },
    "frontend": {
      "type": "object", "additionalProperties": false,
      "required": ["replicas", "config", "terminationGracePeriodSeconds", "podAnnotations", "podSecurityContext", "securityContext", "probes", "resources", "topologySpreadConstraints", "affinity", "tolerations", "pdb", "autoscaling"],
      "properties": {
        "replicas": {"type": "integer", "minimum": 1},
        "config": {"type": "object", "additionalProperties": false, "required": ["remoteApiUrl", "publicApiUrl", "publicWsUrl"], "properties": {"remoteApiUrl": {"type": "string"}, "publicApiUrl": {"type": "string"}, "publicWsUrl": {"type": "string"}}},
        "terminationGracePeriodSeconds": {"type": "integer", "minimum": 15},
        "podAnnotations": {"$ref": "#/definitions/stringMap"},
        "podSecurityContext": {"type": "object"},
        "securityContext": {"$ref": "#/definitions/securityContext"},
        "probes": {"$ref": "#/definitions/probes"},
        "resources": {"type": "object"},
        "topologySpreadConstraints": {"type": "array"},
        "affinity": {"type": "object"},
        "tolerations": {"type": "array"},
        "pdb": {"$ref": "#/definitions/pdb"},
        "autoscaling": {"$ref": "#/definitions/autoscaling"}
      }
    },
    "ingress": {"type": "object", "additionalProperties": false, "required": ["enabled", "className", "host", "annotations", "tls"], "properties": {"enabled": {"type": "boolean"}, "className": {"type": "string", "minLength": 1}, "host": {"type": "string", "minLength": 1}, "annotations": {"$ref": "#/definitions/stringMap"}, "tls": {"type": "array"}}},
    "networkPolicy": {"type": "object", "additionalProperties": false, "required": ["enabled", "ingressCidrs", "databaseCidrs", "redisCidrs", "backendExternalEgressCidrs"], "properties": {"enabled": {"type": "boolean"}, "ingressCidrs": {"$ref": "#/definitions/cidrs"}, "databaseCidrs": {"$ref": "#/definitions/cidrs"}, "redisCidrs": {"$ref": "#/definitions/cidrs"}, "backendExternalEgressCidrs": {"$ref": "#/definitions/cidrs"}}},
    "monitoring": {"type": "object", "additionalProperties": false, "required": ["namespaceLabels", "podLabels", "serviceMonitor", "prometheusRule"], "properties": {"namespaceLabels": {"$ref": "#/definitions/stringMap"}, "podLabels": {"$ref": "#/definitions/stringMap"}, "serviceMonitor": {"type": "object", "additionalProperties": false, "required": ["enabled", "additionalLabels", "interval"], "properties": {"enabled": {"type": "boolean"}, "additionalLabels": {"$ref": "#/definitions/stringMap"}, "interval": {"type": "string"}}}, "prometheusRule": {"type": "object", "additionalProperties": false, "required": ["enabled", "additionalLabels"], "properties": {"enabled": {"type": "boolean"}, "additionalLabels": {"$ref": "#/definitions/stringMap"}}}}},
    "revisionHistoryLimit": {"type": "integer", "minimum": 1}
  },
  "definitions": {
    "stringMap": {"type": "object", "additionalProperties": {"type": "string"}},
    "cidrs": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-fA-F:.]+/[0-9]{1,3}$"}},
    "image": {"type": "object", "additionalProperties": false, "required": ["repository", "tag", "digest", "pullPolicy"], "properties": {"repository": {"type": "string", "minLength": 1}, "tag": {"type": "string", "minLength": 1, "not": {"const": "latest"}}, "digest": {"type": "string", "pattern": "^$|^sha256:[a-f0-9]{64}$"}, "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}}},
    "images": {"type": "object", "additionalProperties": false, "required": ["backend", "frontend"], "properties": {"backend": {"$ref": "#/definitions/image"}, "frontend": {"$ref": "#/definitions/image"}}},
    "securityContext": {"type": "object", "additionalProperties": false, "required": ["allowPrivilegeEscalation", "readOnlyRootFilesystem", "capabilities"], "properties": {"allowPrivilegeEscalation": {"const": false}, "readOnlyRootFilesystem": {"const": true}, "capabilities": {"type": "object", "additionalProperties": false, "required": ["drop"], "properties": {"drop": {"type": "array", "contains": {"const": "ALL"}}}}}},
    "probeTiming": {"type": "object", "additionalProperties": false, "required": ["periodSeconds"], "properties": {"periodSeconds": {"type": "integer", "minimum": 1}, "timeoutSeconds": {"type": "integer", "minimum": 1}, "failureThreshold": {"type": "integer", "minimum": 1}}},
    "probes": {"type": "object", "additionalProperties": false, "required": ["startup", "readiness", "liveness"], "properties": {"startup": {"$ref": "#/definitions/probeTiming"}, "readiness": {"$ref": "#/definitions/probeTiming"}, "liveness": {"$ref": "#/definitions/probeTiming"}}},
    "pdb": {"type": "object", "additionalProperties": false, "required": ["enabled", "minAvailable"], "properties": {"enabled": {"type": "boolean"}, "minAvailable": {"oneOf": [{"type": "integer", "minimum": 0}, {"type": "string"}]}}},
    "autoscaling": {"type": "object", "additionalProperties": false, "required": ["enabled", "minReplicas", "maxReplicas", "targetCPUUtilizationPercentage"], "properties": {"enabled": {"type": "boolean"}, "minReplicas": {"type": "integer", "minimum": 1}, "maxReplicas": {"type": "integer", "minimum": 1}, "targetCPUUtilizationPercentage": {"type": "integer", "minimum": 1, "maximum": 100}}}
  }
}

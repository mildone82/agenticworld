name        = "multica"
environment = "prod"
aws_region  = "us-east-1"

vpc_cidr          = "10.40.0.0/16"
single_nat_gateway = false

cluster_endpoint_public_access = false
node_instance_types             = ["m7i.large"]
node_min_size                   = 2
node_desired_size               = 3
node_max_size                   = 6

postgres_instance_class       = "db.m7g.large"
postgres_allocated_storage    = 100
postgres_max_allocated_storage = 500
postgres_deletion_protection  = true

redis_node_type          = "cache.t4g.small"
redis_num_cache_clusters = 2

domain_name    = "multica.example.com"
route53_zone_id = "Z00000000000000000000"

monthly_budget_usd = 1500
budget_alert_emails = ["platform@example.com"]

tags = {
  Owner      = "platform"
  CostCenter = "engineering"
}
